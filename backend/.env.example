# copy to .env and fill values

# App
PORT=3000
# in production change value to production
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017
DB_NAME=appdb

# JWT
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12

# SMTP
# Optional in development: if SMTP_HOST is empty, mail links are only logged
# instead of being sent. In production SMTP is required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@example.com
SMTP_PASS=password123
MAIL_FROM="Your App <no-reply@yourapp.com>"


# Frontend
CLIENT_BASE_URL=http://localhost:5173

# OpenFoodFacts
# Produktion: https://world.openfoodfacts.org (kein OFF_BASIC_AUTH nötig)
# Staging:    https://world.openfoodfacts.net mit OFF_BASIC_AUTH=off:off
OFF_BASE_URL=https://world.openfoodfacts.org
# Pflichtformat AppName/Version (ContactEmail), echte Kontakt-Mail eintragen
OFF_USER_AGENT=Cookeroo/1.0 (your-contact@example.com)
OFF_BASIC_AUTH=
OFF_TIMEOUT_MS=10000
OFF_CACHE_TTL_MS=300000
OFF_CACHE_MAX_ENTRIES=200
